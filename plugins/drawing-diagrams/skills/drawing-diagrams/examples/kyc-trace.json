  "groups": {
    "user": {
      "label": "пользователь",
      "ramp": "pink"
    },
    "graph": {
      "label": "граф",
      "ramp": "purple"
    },
    "res": {
      "label": "резолвер",
      "ramp": "teal"
    },
    "adapter": {
      "label": "адаптер",
      "ramp": "coral"
    },
    "vendor": {
      "label": "вендор",
      "ramp": "gray"
    }
  },
  "lanes": [
    "user",
    "graph",
    "res",
    "adapter",
    "vendor"
  ],
  "nodes": [
    {
      "id": "buy",
      "title": "Покупка",
      "text": "Марк жмёт «купить»"
    },
    {
      "id": "node",
      "title": "Узел KYC",
      "text": "гейт: документ, селфи"
    },
    {
      "id": "rules",
      "title": "Правила",
      "text": "нет строки, нет попытки"
    },
    {
      "id": "fire",
      "title": "fire",
      "text": "профиль basic-kyc"
    },
    {
      "id": "attempt",
      "title": "Попытка",
      "text": "applicant, level, ссылка"
    },
    {
      "id": "handoff",
      "title": "Handoff",
      "text": "открывает виджет"
    },
    {
      "id": "verify",
      "title": "Проверка",
      "text": "документ и селфи"
    },
    {
      "id": "webhook",
      "title": "Вебхук",
      "text": "approved"
    },
    {
      "id": "verdict",
      "title": "Вердикт",
      "text": "approved, закрыта"
    },
    {
      "id": "resume",
      "title": "Resume",
      "text": "covered"
    },
    {
      "id": "green",
      "kind": "terminal",
      "title": "GREEN"
    }
