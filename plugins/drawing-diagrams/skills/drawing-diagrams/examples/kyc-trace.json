  "grid": [
    "buy      .      .       .        .",
    ".        node   .       .        .",
    ".        .      rules   .        .",
    ".        .      fire    .        .",
    ".        .      .       attempt  .",
    "handoff  .      .       .        .",
    ".        .      .       .        verify",
    ".        .      .       .        webhook",
    ".        .      .       verdict  .",
    ".        .      resume  .        .",
    ".        green  .       .        ."
  ],
  "edges": [
    "buy -> node",
    "node -> rules",
    "rules -> fire",
    "fire -> attempt",
    "attempt -> handoff : ссылка",
    "handoff -> verify",
    "verify -> webhook",
    "webhook -> verdict | dashed",
    "verdict -> resume",
    "resume -> green"
  ],
  "routes": {
    "путь Марка": [
      "buy",
      "node",
      "rules",
      "fire",
      "attempt",
      "handoff",
      "verify",
      "webhook",
      "verdict",
      "resume",
      "green"
    ]
  }
