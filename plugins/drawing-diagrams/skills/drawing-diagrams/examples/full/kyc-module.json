          "type": "bigint"
        },
        {
          "name": "opened_at",
          "type": "timestamptz"
        },
        {
          "name": "closed_at",
          "type": "timestamptz",
          "flags": [
            "N"
          ]
        }
      ],
      "details": [
        "<code>status</code>: open · approved · declined_retry · declined_final · expired",
        "вебхук: UNIQUE (connection_id, external_attempt_id)",
        "свипер: индекс (deadline) WHERE status = open"
      ],
      "notes": [
        "claim: UNIQUE (connection_id, user_id) WHERE status = open"
      ]
    },
    {
