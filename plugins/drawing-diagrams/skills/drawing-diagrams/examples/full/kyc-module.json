  "edges": [
    "verdicts.attempt_id -> attempts.attempt_id | ends=plain/one",
    "history.profile -> verdicts.profile",
    "checks.attempt_id -> attempts.attempt_id | right",
    "outbox.external_correlation_id -> attempts.external_attempt_id | logical"
  ]
}
