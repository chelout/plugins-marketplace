        {
          "name": "connection_id",
          "type": "uuid",
          "flags": [
            "PK"
          ],
          "key": "connection"
        },
        {
          "name": "user_id",
          "type": "text",
          "flags": [
            "PK"
          ],
          "key": "user"
        },
        {
          "name": "profile",
          "type": "text",
          "flags": [
            "PK"
          ],
          "key": "profile"
        },
        {
          "name": "attempt_id",
          "type": "uuid",
          "flags": [
            "FK",
            "N"
          ],
          "key": "attempt"
        },
        {
          "name": "review_status",
          "type": "text"
        },
        {
          "name": "proofs",
          "type": "text[]"
        },
        {
          "name": "review_result",
          "type": "jsonb",
          "flags": [
            "N"
          ]
        },
        {
          "name": "checked_at",
          "type": "timestamptz"
        },
        {
          "name": "valid_until",
          "type": "timestamptz",
          "flags": [
            "N"
          ]
        },
        {
          "name": "invalidated_at",
          "type": "timestamptz",
          "flags": [
            "N"
          ]
        },
        {
          "name": "invalid_reason",
          "type": "text",
          "flags": [
            "N"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz"
        },
        {
          "name": "updated_at",
          "type": "timestamptz"
        }
      ],
      "details": [
        "<code>review_status</code>: approved · declined_retry · declined_final · invalid",
        "<code>invalid_reason</code>: vendor_reset · vendor_rejected · proof_revoked:&lt;пруф&gt;",
        "CHECK: approved требует непустой <code>proofs</code>; invalid требует <code>invalid_reason</code>",
        "<code>review_result</code>: review_answer, reject_type, reject_labels и ничего больше"
      ],
      "notes": [
        "proofs: снимок строки матрицы в момент вердикта, дальше не меняется"
      ]
    },
    {
      "id": "attempts",
