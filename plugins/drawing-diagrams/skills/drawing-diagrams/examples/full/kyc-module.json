{
  "kind": "schema",
  "id": "kyc-module",
  "title": "KYC-модуль: таблицы",
  "summary": "Карта ключей KYC-модуля: шесть таблиц модуля и три таблицы за портом адаптера, связанные по ключам учётки, пользователя, профиля и попытки.",
  "grid": [
    "matrix   verdicts    attempts",
    "subject  history     outbox",
    "conn     applicants  checks"
  ],
  "groups": {
    "cfg": {
      "label": "конфигурация",
      "ramp": "purple"
    },
    "ven": {
      "label": "истина вендора",
      "ramp": "teal"
    },
    "run": {
      "label": "истина рантайма",
      "ramp": "coral"
    },
    "out": {
      "label": "за портом адаптера",
      "ramp": "gray",
      "outside": true
    }
  },
  "tables": [
    {
      "id": "matrix",
      "name": "kyc_profile_matrix",
      "group": "cfg",
      "subtitle": "матрица · истина конфигурации",
      "columns": [
        {
          "name": "connection_id",
          "type": "uuid",
          "flags": [
            "PK"
          ],
          "key": "connection"
        },
        {
          "name": "profile",
          "type": "text",
          "flags": [
            "PK"
          ],
          "key": "profile"
        },
        {
          "name": "proofs",
          "type": "text[]"
        },
        {
          "name": "countries",
          "type": "text[]",
          "flags": [
            "N"
          ]
        },
        {
          "name": "valid_for",
          "type": "interval",
          "flags": [
            "N"
          ]
        },
        {
          "name": "updated_at",
          "type": "timestamptz"
        },
        {
          "name": "updated_by",
          "type": "text"
        }
      ],
      "details": [
        "<code>countries</code> NULL: без ограничения по стране; <code>valid_for</code> NULL: горизонта нет",
        "элементы <code>proofs</code> только из словаря пруфов в коде",
        "publish проверяет: каждое требование графа даёт ровно один профиль"
      ]
    },
    {
      "id": "verdicts",
      "name": "kyc_verdicts",
      "group": "ven",
      "subtitle": "вердикты · истина вендора",
